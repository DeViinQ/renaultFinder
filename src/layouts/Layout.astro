---
import "../styles/global.css";
import ReportLostModal from "../components/ReportLostModal.astro";
import ReportFoundModal from "../components/ReportFoundModal.astro";
interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/" aria-label="Renault Finder, inicio">
					<img src="/img/logo.png" alt="" />
					<span>Renault <strong>Finder</strong></span>
				</a>
				<nav aria-label="Navegación principal">
					<a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Inicio</a>
					<a href="/busqueda" aria-current={Astro.url.pathname === "/busqueda" ? "page" : undefined}>Buscar objeto</a>
					<a href="/perdidos" aria-current={Astro.url.pathname === "/perdidos" ? "page" : undefined}>Perdidos</a>
					<a href="/encontrados" aria-current={Astro.url.pathname === "/encontrados" ? "page" : undefined}>Encontrados</a>
				</nav>
			</div>
		</header>
		<slot />
		<ReportLostModal />
		<ReportFoundModal />
	</body>
</html>
