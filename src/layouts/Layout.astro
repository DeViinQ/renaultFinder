---
import "../styles/global.css";
interface Props {
	title: string;
}
const { title } = Astro.props;
// PASTELES VERDES Y CELESTES
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="text-center flex flex-col h-32 bg-gray-950 text-white">
		<header
			class="backdrop-blur-2xl p-4 flex items-center justify-between"
		>
			<div class="flex items-center gap-x-4">
				<img
					src="/img/logo.png"
					alt="Logo"
					class="mx-auto mb-2 w-16 h-16"
				/>
				<h1 class="text-2xl font-bold">{title}</h1>
			</div>

			<div class="flex gap-x-4">
				<a href="/">Home</a>
				<a href="/busqueda">Buscar Objeto</a>
				<a href="/perdidos">Objetos Perdidos</a>
				<a href="/encontrados">Objetos Encontrados</a>
			</div>
		</header>
		<slot />
	</body>
</html>
