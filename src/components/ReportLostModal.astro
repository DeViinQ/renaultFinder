---
import ReportLostForm from "./ReportLostForm.jsx";
---

<dialog
	class="report-dialog"
	id="report-lost-dialog"
	aria-labelledby="report-dialog-title"
	aria-describedby="report-dialog-description"
>
	<div class="report-dialog-panel">
		<div class="report-dialog-heading">
			<div>
				<p class="page-section-kicker">Un reencuentro puede empezar aquí</p>
				<h2 id="report-dialog-title">Reportar objeto perdido</h2>
				<p id="report-dialog-description">Cuéntanos lo que recuerdes. Los detalles ayudan a encontrarlo.</p>
			</div>
			<button class="report-dialog-close" type="button" data-close-report-dialog aria-label="Cerrar panel">×</button>
		</div>

		<ReportLostForm client:load />
	</div>
</dialog>

<script>
	const reportDialog = document.querySelector<HTMLDialogElement>("#report-lost-dialog");

	if (reportDialog) {
		const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-open-report-dialog]");
		const closeButtons = reportDialog.querySelectorAll<HTMLButtonElement>("[data-close-report-dialog]");
		let lastTrigger: HTMLButtonElement | null = null;

		openButtons.forEach((button) => {
			button.addEventListener("click", () => {
				lastTrigger = button;
				reportDialog.showModal();
			});
		});

		closeButtons.forEach((button) => {
			button.addEventListener("click", () => reportDialog.close());
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && reportDialog.open) reportDialog.close();
		});

		reportDialog.addEventListener("close", () => lastTrigger?.focus());

		reportDialog.addEventListener("click", (event) => {
			if (event.target === reportDialog) reportDialog.close();
		});
	}
</script>
