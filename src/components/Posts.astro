---
import { supabase } from "../db/supabase";

const { data: avisos, error } = await supabase
    .from("avisos")
    .select("*")
    .order("created_at", { ascending: false });

if (error) {
    console.error(error);
}
---

{
    avisos?.map((aviso) => (
        <article class="listing-card">
            <div class="listing-card-art">
                {aviso.imageurl ? (
                    <img src={aviso.imageurl} alt={aviso.title} />
                ) : (
                    <span class="listing-card-emoji" aria-hidden="true">🎒</span>
                )}
                <span class="listing-card-tag">{aviso.type}</span>
            </div>
            <div class="listing-card-body">
                <h3>{aviso.title}</h3>
                <p>{aviso.details}</p>
                <div class="listing-card-meta">
                    <span><span class="mr-[5px] text-[#6ea991]" aria-hidden="true">⌖</span>{aviso.place}</span>
                    <time datetime={aviso.created_at}>
                        {new Date(aviso.created_at).toLocaleDateString("es-AR")}
                    </time>
                </div>
            </div>
        </article>
    ))
}
