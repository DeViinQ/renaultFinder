---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../db/supabase";

const category = Astro.url.searchParams.get("category");
const place = Astro.url.searchParams.get("place");
const date = Astro.url.searchParams.get("date");

let query = supabase
	.from("avisos")
	.select("*")
	.eq("type", "Encontrado");

if (category) {
	query = query.eq("category", category);
}
if (place) {
	query = query.ilike("place", `%${place}%`);
}
if (date) {
	query = query.gte("created_at", date);
}

const { data: avisos, error } = await query.order("created_at", { ascending: false });

if (error) {
	console.error(error);
}
---

<Layout title="Objetos encontrados | Renault Finder">
	<main class="design-page">
		<section class="page-hero">
			<div class="page-hero-copy">
				<p class="page-kicker"><span class="size-2 rounded-full bg-[#80c4a0]"></span>Un gesto puede cambiar el día</p>
				<h1>¿Encontraste algo?<br /><span>Hagamos que vuelva.</span></h1>
				<p>
					Publica los detalles del objeto para que su dueño pueda reconocerlo. La comunidad te ayuda con el reencuentro.
				</p>
				<button class="page-button" type="button" data-open-report-found-dialog>＋ Compartir un objeto encontrado</button>
			</div>
			<div class="page-hero-art" aria-hidden="true">
				<div class="absolute top-3 right-[30px] size-[155px] rounded-full bg-[#e2f2e9]"></div>
				<div class="absolute right-0 bottom-[5px] h-[130px] w-[230px] rounded-[52%_48%_42%_58%/57%_47%_53%_43%] bg-[#dceff3] -rotate-2"></div>
				<div class="art-note">
					<span class="art-note-icon">✓</span>
					Un hallazgo,<br />una alegría
				</div>
			</div>
		</section>

		<section class="page-section" aria-labelledby="found-title">
			<div class="page-section-heading">
				<div>
					<p class="page-section-kicker">La comunidad comparte</p>
					<h2 id="found-title">Objetos encontrados</h2>
					<p>Estos objetos esperan reencontrarse con sus dueños.</p>
				</div>
				{avisos && <div class="listing-count"><span>{avisos.length}</span> avisos</div>}
			</div>

			<form method="get" class="page-search">
				<span class="page-search-icon" aria-hidden="true">⌕</span>
				<span class="sr-only">Buscar objetos encontrados</span>
				<input type="search" name="place" placeholder="Filtrar por lugar..." value={place || ""} />
				<input type="date" name="date" value={date || ""} />
				<button type="submit">Filtrar</button>
			</form>

			<nav class="category-list" aria-label="Categorías de objetos">
				<a class={!category ? "category active" : "category"} href="/encontrados">Todos</a>
				<a class={category === "Mochilas y bolsos" ? "category active" : "category"} href="/encontrados?category=Mochilas+y+bolsos">Mochilas y bolsos</a>
				<a class={category === "Tecnología" ? "category active" : "category"} href="/encontrados?category=Tecnología">Tecnología</a>
				<a class={category === "Útiles" ? "category active" : "category"} href="/encontrados?category=Útiles">Útiles</a>
				<a class={category === "Otros" ? "category active" : "category"} href="/encontrados?category=Otros">Otros</a>
			</nav>

			<div class="listing-grid">
				{avisos && avisos.length > 0 ? (
					avisos.map((aviso) => (
						<article class="listing-card">
							<div class="listing-card-art">
								{aviso.imageurl ? (
									<img src={aviso.imageurl} alt={aviso.title} />
								) : (
									<span class="listing-card-emoji" aria-hidden="true">🔑</span>
								)}
								<span class="listing-card-tag">{aviso.category || "Objeto"}</span>
							</div>
							<div class="listing-card-body">
								<h3>{aviso.title}</h3>
								<p>{aviso.details}</p>
								<div class="listing-card-meta">
									<span><span class="mr-[5px] text-[#6ea991]" aria-hidden="true">⌖</span>{aviso.place}</span>
									<span>{aviso.created_at ? new Date(aviso.created_at).toLocaleDateString("es-AR") : ""}</span>
								</div>
							</div>
						</article>
					))
				) : (
					<p class="section-description">Todavía no hay objetos encontrados publicados.</p>
				)}
			</div>
		</section>

		<aside class="page-callout">
			<div class="page-callout-icon" aria-hidden="true">✦</div>
			<div>
				<h2>¿Es algo que perdiste?</h2>
				<p>Revisa los avisos o cuéntanos qué estás buscando.</p>
			</div>
			<a href="/perdidos">Ver objetos perdidos <span aria-hidden="true">→</span></a>
		</aside>

		<footer class="page-footer">
			<span>Renault Finder <span class="footer-separator">·</span> Encuentra, comparte, sonríe</span>
		</footer>
	</main>
</Layout>
