---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../db/supabase";

const { data: avisos, error } = await supabase
	.from("avisos")
	.select("*")
	.eq("type", "Perdido")
	.order("created_at", { ascending: false });

if (error) {
	console.error(error);
}
---

<Layout title="Objetos perdidos | Renault Finder">
	<main class="lost-page">
		<section class="intro">
			<div class="intro-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Nos ayudamos entre todos</p>
				<h1>¿Perdiste algo?<br /><span>Vamos a encontrarlo.</span></h1>
				<p class="intro-description">
					Explora los objetos reportados por la comunidad y vuelve a conectar con eso que te hace falta.
				</p>
				<button class="primary-button" type="button" data-open-report-dialog>
					<span aria-hidden="true">＋</span> Reportar un objeto perdido
				</button>
			</div>
		</section>

		<section class="listings" aria-labelledby="listings-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow section-eyebrow">Un poquito de ayuda</p>
					<h2 id="listings-title">Objetos que buscan volver a casa</h2>
					<p class="section-description">Quizá alguien ya encontró eso que estás buscando.</p>
				</div>
				{avisos && <div class="listing-count"><span>{avisos.length}</span> objetos publicados</div>}
			</div>

			<div class="toolbar">
				<label class="search-box">
					<span class="search-icon" aria-hidden="true">⌕</span>
					<span class="sr-only">Buscar objetos</span>
					<input type="search" placeholder="¿Qué estás buscando?" />
					<kbd>⌘ K</kbd>
				</label>
				<label class="sort-box">
					<span class="sr-only">Ordenar objetos</span>
					<select>
						<option>Más recientes</option>
						<option>Más antiguos</option>
					</select>
				</label>
			</div>

			<nav class="category-list" aria-label="Categorías de objetos">
				<a class="category active" href="/perdidos">Todos</a>
				<a class="category" href="/perdidos">Mochilas y bolsos</a>
				<a class="category" href="/perdidos">Tecnología</a>
				<a class="category" href="/perdidos">Útiles</a>
				<a class="category" href="/perdidos">Otros</a>
			</nav>

			<div class="object-grid">
				{avisos && avisos.length > 0 ? (
					avisos.map((aviso) => (
						<article class="object-card">
							<div class="object-illustration">
								{aviso.imageurl ? (
									<img src={aviso.imageurl} alt={aviso.title} />
								) : (
									<span class="item-emoji" aria-hidden="true">🎒</span>
								)}
								<span class="object-tag">{aviso.category || "Objeto"}</span>
							</div>
							<div class="object-info">
								<div class="object-title-row">
									<h3>{aviso.title}</h3>
									<span class="status-dot"></span>
								</div>
								<p class="object-detail">{aviso.details}</p>
								<div class="object-meta">
									<span><span aria-hidden="true">⌖</span> {aviso.place}</span>
									<span>{aviso.created_at ? new Date(aviso.created_at).toLocaleDateString("es-AR") : ""}</span>
								</div>
							</div>
						</article>
					))
				) : (
					<p class="section-description">Todavía no hay objetos publicados. Si perdiste algo, puedes reportarlo para que la comunidad te ayude.</p>
				)}
			</div>
		</section>

		<aside class="help-banner">
			<div class="help-icon" aria-hidden="true">✦</div>
			<div>
				<h2>¿Encontraste algo que no es tuyo?</h2>
				<p>Un pequeño gesto puede alegrarle el día a alguien.</p>
			</div>
			<a href="/encontrados">Ver objetos encontrados <span aria-hidden="true">→</span></a>
		</aside>

		<footer class="page-footer">
			<span>Hecho con <span class="footer-heart" aria-label="cariño">♥</span> para nuestra comunidad</span>
			<span>Renault Finder <span class="footer-separator">·</span> Encuentra, comparte, sonríe</span>
		</footer>
	</main>
</Layout>
